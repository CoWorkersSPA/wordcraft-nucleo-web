+++ b/crates/proof/tests/default_language.rs
@@ -0,0 +1,26 @@
+//! The default proofing language is global state, so it is tested here, in its own process, and not next to tests that expect English.
+
+use wordcraft_proof::ProofLang;
+use wordcraft_proof::lang::{default_language, set_default_language};
+
+#[test]
+fn default_language_applies_to_untagged_text_and_to_plain_us_english() {
+    assert_eq!(default_language(), ProofLang::En, "English until a front end says otherwise");
+    assert_eq!(ProofLang::from_tag(Some("en-US")), ProofLang::En);
+
+    set_default_language(ProofLang::Es419);
+    // What nobody chose: no tag, an empty one, and the en-US a new document carries.
+    for t in [None, Some(""), Some("en"), Some("en-US"), Some("EN-us"), Some("en_US"), Some(" en-US ")] {
+        assert_eq!(ProofLang::from_tag(t), ProofLang::Es419, "{t:?}");
+    }
+    // What someone chose stays: another English, Spanish itself, and other languages.
+    assert_eq!(ProofLang::from_tag(Some("en-GB")), ProofLang::EnGb);
+    assert_eq!(ProofLang::from_tag(Some("en-AU")), ProofLang::EnGb);
+    assert_eq!(ProofLang::from_tag(Some("en-Latn-US")), ProofLang::En);
+    assert_eq!(ProofLang::from_tag(Some("es-ES")), ProofLang::Es);
+    assert_eq!(ProofLang::from_tag(Some("pt-BR")), ProofLang::Pt);
+    assert_eq!(ProofLang::from_tag(Some("fr-FR")), ProofLang::Other);
+
+    set_default_language(ProofLang::En);
+    assert_eq!(ProofLang::from_tag(Some("en-US")), ProofLang::En);
+}
