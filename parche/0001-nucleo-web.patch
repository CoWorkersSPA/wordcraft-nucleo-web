+    parts.next().is_some_and(|p| p.eq_ignore_ascii_case("en")) && parts.next().is_none_or(|r| r.eq_ignore_ascii_case("us")) && parts.next().is_none()
+}
+
+/// The language of text that has none (no `w:lang` anywhere): English, WordCraft's default editing
+/// language like Word's, until the front end sets another one.
+static DEFAULT_LANGUAGE: std::sync::RwLock<ProofLang> = std::sync::RwLock::new(ProofLang::En);
+
+/// The language text with no language tag is proofed in.
+pub fn default_language() -> ProofLang {
+    *DEFAULT_LANGUAGE.read().unwrap_or_else(|e| e.into_inner())
+}
+
+/// Proof text with no language tag, and text in plain `en-US` (see [`ProofLang::from_tag`]), in `lang`
+/// from now on (the web build sets Spanish). Callers drop what they cached for the old language
+/// ([`crate::data_arrived`]).
+pub fn set_default_language(lang: ProofLang) {
+    *DEFAULT_LANGUAGE.write().unwrap_or_else(|e| e.into_inner()) = lang;
+}
+
 /// A BCP 47 tag in canonical case (`pl-PL`, `en-GB`, `zh-Hant-TW`, `x-none`), or `None` when
