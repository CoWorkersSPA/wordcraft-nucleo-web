+
+[dependencies]
+wordcraft-engine = { workspace = true }
+wordcraft-fonts = { workspace = true }
+wordcraft-extdata = { workspace = true }
+wordcraft-geom = { workspace = true }
+serde_json = { workspace = true }
+log = { workspace = true }
