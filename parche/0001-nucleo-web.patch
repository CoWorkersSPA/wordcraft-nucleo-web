diff --git a/crates/extdata/src/lib.rs b/crates/extdata/src/lib.rs
new file mode 100644
index 0000000..c6e4592
--- /dev/null
+++ b/crates/extdata/src/lib.rs
@@ -0,0 +1,48 @@
+//! Data the web build keeps out of the wasm. The page fetches the files (fonts, interface
+//! catalogs, hyphenation patterns) and hands their bytes to [`provide`] before the app starts;
+//! the crates that used to `include_bytes!` them call [`bytes`] / [`text`] instead. Desktop builds
+//! still embed everything and never touch this registry.
+
+use std::collections::HashMap;
+use std::sync::Mutex;
+
+static FILES: Mutex<Option<HashMap<String, &'static [u8]>>> = Mutex::new(None);
+
+/// Register a fetched file under its asset-relative name (`fonts/Inter-Regular.ttf`). The bytes
+/// are leaked on purpose: callers hold `&'static` slices for the life of the page.
+pub fn provide(name: &str, data: Vec<u8>) {
+    if let Ok(mut g) = FILES.lock() {
+        g.get_or_insert_with(HashMap::new).insert(name.to_owned(), Box::leak(data.into_boxed_slice()));
+    }
+}
+
+/// A registered file, or `None` when the page has not provided it.
+pub fn bytes(name: &str) -> Option<&'static [u8]> {
+    FILES.lock().ok()?.as_ref()?.get(name).copied()
+}
+
+/// A registered text file (empty when missing or not UTF-8).
+pub fn text(name: &str) -> &'static str {
+    bytes(name).and_then(|b| std::str::from_utf8(b).ok()).unwrap_or("")
+}
+
+static WANTED: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+/// Ask the page to fetch `name` (not yet provided) the next time it looks; each name is queued
+/// once. This is how code that needs a file synchronously (font lookup) says it wants one it
+/// started without.
+pub fn request(name: &str) {
+    if bytes(name).is_some() {
+        return;
+    }
+    if let Ok(mut w) = WANTED.lock()
+        && !w.iter().any(|n| n == name)
+    {
+        w.push(name.to_owned());
+    }
+}
+
+/// The names asked for since the last call.
+pub fn take_requests() -> Vec<String> {
+    WANTED.lock().map(|mut w| std::mem::take(&mut *w)).unwrap_or_default()
+}
