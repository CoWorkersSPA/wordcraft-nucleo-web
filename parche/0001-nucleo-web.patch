@@ -0,0 +1,47 @@
+//! Hand-written synthetic Spanish test data. No words, rules or suggestion tables were copied
+//! from a real dictionary. This is a small fixture, not a redistributable Spanish dictionary.
+
+pub const AFF: &str = "SET UTF-8
+FLAG UTF-8
+FORBIDDENWORD F
+TRY aeionrslctdumpbgvyqhfzjñxwkáíóúé
+KEY qwertyuiop|asdfghjkl|zxcvbnm
+MAP 3
+MAP aá
+MAP eé
+MAP ií
+REP 3
+REP ss s
+REP nio ño
+REP cion ción
+SFX S Y 1
+SFX S 0 s [^n]
+SFX P Y 2
+SFX P ón ones ón
+SFX P 0 es [^ón]
+";
+
+pub const DIC: &str = "16
+casa/S
