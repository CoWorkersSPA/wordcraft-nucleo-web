index 0000000..c596376
--- /dev/null
+++ b/crates/proof/src/es/mod.rs
@@ -0,0 +1,254 @@
+//! Spanish proofing using a Hunspell dictionary (`es_CL`, `es_ES`… never bundled in the binary:
+//! desktop reads the one installed on the system, the web build gets `dic/es-CL.aff` and
+//! `dic/es-CL.dic` from the page when Spanish text first needs them). Suggestions use the
+//! dictionary's own MAP/REP/TRY/KEY tables. Grammar is limited to generic repeated-word and
+//! spacing checks with Spanish messages; hyphenation keeps the English fallback (no Spanish
+//! patterns are bundled).
+
+pub mod grammar;
+mod suggest;
+#[cfg(test)]
+pub(crate) mod test_dict;
+
+use std::sync::{Arc, OnceLock, RwLock};
+
+use crate::affix::AffixDict;
+
+pub use suggest::suggest;
+
+/// The Spanish dictionary: `None` until first use, then the installed one (or an empty one).
+static DICT: RwLock<Option<Arc<AffixDict>>> = RwLock::new(None);
+
+/// File names of a Spanish Hunspell dictionary, the regional ones first.
+const NAMES: &[&str] = &["es_CL", "es-CL", "es_ES", "es-ES", "es_MX", "es-MX", "es_ANY", "es"];
+
+/// What the web page provides (under its `assets/` folder): the Chilean dictionary of RLA-ES.
+#[cfg(target_arch = "wasm32")]
+const WEB_AFF: &str = "dic/es-CL.aff";
+#[cfg(target_arch = "wasm32")]
+const WEB_DIC: &str = "dic/es-CL.dic";
+
+/// The Spanish dictionary: the installed Hunspell one (read on first use), one given with
+/// [`install_dictionary`], or an empty one when none is available (Spanish spelling is off then;
+/// see [`has_dictionary`]). On the web, while the page has not provided the files it asks for them
+/// and answers with an empty dictionary without remembering it, so the words show no marks
+/// meanwhile and are checked once the files arrive ([`crate::data_arrived`]).
+pub fn dictionary() -> Arc<AffixDict> {
+    if let Some(d) = DICT.read().unwrap_or_else(|e| e.into_inner()).as_ref() {
+        return d.clone();
+    }
+    let Some(loaded) = load() else {
+        static EMPTY: OnceLock<Arc<AffixDict>> = OnceLock::new();
+        return EMPTY.get_or_init(|| Arc::new(AffixDict::default())).clone();
+    };
+    let mut slot = DICT.write().unwrap_or_else(|e| e.into_inner());
+    // Another thread (or an install) may have filled it meanwhile: that one wins.
+    slot.get_or_insert(Arc::new(loaded)).clone()
+}
+
+#[cfg(target_arch = "wasm32")]
+fn load() -> Option<AffixDict> {
+    wordcraft_extdata::request(WEB_AFF);
+    wordcraft_extdata::request(WEB_DIC);
+    let (aff, dic) = (wordcraft_extdata::text(WEB_AFF), wordcraft_extdata::text(WEB_DIC));
+    if aff.is_empty() || dic.is_empty() {
+        return None;
+    }
+    AffixDict::from_hunspell(aff, dic, &[])
+        .map_err(|e| log::warn!("Spanish spelling: {e}"))
+        .ok()
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+fn load() -> Option<AffixDict> {
+    let Some((aff, dic)) = crate::hunspell::find(NAMES) else {
+        crate::hunspell::clear_load_error(NAMES[0]);
+        log::info!("Spanish spelling: no Hunspell Spanish dictionary installed");
+        return Some(AffixDict::default());
+    };
+    Some(crate::hunspell::note_load(NAMES[0], &dic, crate::hunspell::load(&aff, &dic)).unwrap_or_else(|e| {
+        log::warn!("Spanish spelling: {e}");
+        AffixDict::default()
+    }))
+}
+
+/// Use this Spanish dictionary from now on (Hunspell `.aff` and `.dic` text, decoded to UTF-8),
+/// for example one the user picked. On error the current dictionary stays.
+pub fn install_dictionary(aff: &str, dic: &str) -> Result<(), String> {
+    let d = AffixDict::from_hunspell(aff, dic, &[])?;
+    *DICT.write().unwrap_or_else(|e| e.into_inner()) = Some(Arc::new(d));
+    Ok(())
+}
+
+/// Forget the loaded dictionary, so the next check looks for an installed one again (after
+/// [`crate::hunspell::set_dictionary_dir`] or a dictionary was installed).
+pub fn reload_dictionary() {
+    *DICT.write().unwrap_or_else(|e| e.into_inner()) = None;
+}
+
+/// The `.dic` file of the Spanish Hunspell dictionary found in the dictionaries folder or the
+/// system locations now (File › Options › Proofing shows it); `None` when there is none. A
+/// dictionary given with [`install_dictionary`] has no file and isn't reported.
+pub fn installed_path() -> Option<std::path::PathBuf> {
+    crate::hunspell::find(NAMES).map(|(_, dic)| dic)
+}
+
+/// Is a Spanish dictionary available (spelling is checked)?
+pub fn has_dictionary() -> bool {
+    !dictionary().is_empty()
+}
+
+/// Is `c` a letter of the Latin script (the only one the Spanish dictionary covers)?
+fn is_latin_letter(c: char) -> bool {
+    c.is_alphabetic() && (c < '\u{0250}' || ('\u{1E00}'..='\u{1EFF}').contains(&c))
+}
+
+/// Is `word` spelled correctly in Spanish? Numbers, single letters, short words in capitals
+/// (acronyms: `RAE`, `UNAM`), words with digits (`1.º`, `COVID19`) and words in other scripts are
+/// accepted, and so is every word when no Spanish dictionary is available. A hyphenated word is
+/// correct when the dictionary has it whole or has each part (`teórico-práctico`).
+pub fn is_correct(word: &str) -> bool {
+    is_correct_with(&dictionary(), word)
+}
+
+/// [`is_correct`] against a given dictionary (an empty one accepts everything).
+pub fn is_correct_with(d: &AffixDict, word: &str) -> bool {
+    if d.is_empty() {
+        return true; // no Spanish dictionary: no spelling marks
+    }
+    let w = word.trim_matches(|c: char| !c.is_alphanumeric() && c != '\'' && c != '’');
+    let w = w.trim_matches(['\'', '’']);
+    let n = w.chars().count();
+    if n <= 1 || w.chars().any(|c| c.is_ascii_digit()) || !w.chars().any(char::is_alphabetic) {
+        return true;
+    }
+    if w.chars().all(|c| !c.is_lowercase()) && n <= 6 {
+        return true;
+    }
+    if !w.chars().any(is_latin_letter) {
+        return true; // other scripts: no dictionary
+    }
+    if w.contains('-') {
+        return known(d, w)
+            || w.split('-').all(|p| p.chars().count() <= 1 || (p.chars().all(|c| !c.is_lowercase()) && p.chars().count() <= 6) || known(d, p));
+    }
+    known(d, w)
+}
+
+/// Is one word in the dictionary or the user dictionary?
+fn known(d: &AffixDict, w: &str) -> bool {
+    d.check(w) || crate::in_user_dictionary(&w.to_lowercase())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn dictionary_lookup_accepts_spanish_file_names() {
+        let dir = std::env::temp_dir().join(format!("wordcraft-es-aliases-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        for name in ["es_CL", "es-CL", "es_ES", "es_MX", "es_ANY", "es"] {
+            std::fs::write(dir.join(format!("{name}.aff")), test_dict::AFF).unwrap();
+            std::fs::write(dir.join(format!("{name}.dic")), test_dict::DIC).unwrap();
+            let (aff, dic) = crate::hunspell::find_in(&dir, NAMES).unwrap();
+            let d = crate::hunspell::load(&aff, &dic).unwrap();
+            assert!(is_correct_with(&d, "casa"));
+            std::fs::remove_file(aff).unwrap();
+            std::fs::remove_file(dic).unwrap();
+        }
+        std::fs::remove_dir(dir).unwrap();
+    }
+
+    #[test]
+    fn spanish_words_affixes_accents_case_and_hyphens() {
+        test_dict::install();
+        assert!(has_dictionary());
+        for w in ["casa", "casas", "niño", "niños", "canción", "canciones", "Chile", "Casa", "CASA", "teórico-práctico", "RAE", "1.º", "¿casa?", "«niño»"] {
+            assert!(is_correct(w), "{w}");
+        }
+        for w in ["cassa", "ninio", "canzion", "chile", "teórico-prático", "cAsa"] {
+            assert!(!is_correct(w), "{w}");
+        }
+    }
+
+    #[test]
+    fn forbidden_words_are_rejected_in_every_case() {
+        test_dict::install();
+        for w in ["zqterprohibida", "Zqterprohibida", "ZQTERPROHIBIDA"] {
+            assert!(!is_correct(w), "{w}");
+        }
+    }
+
+    #[test]
+    fn missing_dictionary_and_ignored_inputs_are_quiet() {
+        let empty = AffixDict::default();
+        assert!(is_correct_with(&empty, "cassa"));
+        assert!(install_dictionary("FLAG long\n", "1\ncasa\n").is_err());
+        let d = AffixDict::from_hunspell(test_dict::AFF, test_dict::DIC, &[]).unwrap();
+        for w in ["", "a", "2026", "RAE", "ke-2", "日本語", "-", "--"] {
+            assert!(is_correct_with(&d, w), "{w}");
+        }
+    }
+
+    /// The real RLA-ES dictionary, when `WORDCRAFT_ES_DIR` points at a folder with its `index.aff` and
+    /// `index.dic` (the web build's `dic/es-CL.*`): it loads, in good time, and tells Spanish words from mistakes.
+    #[test]
+    fn real_dictionary_when_available() {
+        let Some(dir) = std::env::var_os("WORDCRAFT_ES_DIR").map(std::path::PathBuf::from) else { return };
+        let (aff, dic) = (std::fs::read_to_string(dir.join("index.aff")).unwrap(), std::fs::read_to_string(dir.join("index.dic")).unwrap());
+        let t = std::time::Instant::now();
+        let d = AffixDict::from_hunspell(&aff, &dic, &[]).unwrap();
+        eprintln!("es-CL: {} palabras base, {} reglas, cargó en {:?}", d.len(), d.rule_count(), t.elapsed());
+        for w in [
+            "casa", "casas", "niño", "niños", "canción", "canciones", "corriendo", "comeremos", "hablábamos", "rápidamente", "además", "Chile", "Santiago",
+            "computador", "teléfono", "documento", "ortografía", "acuerdos", "reunión", "también", "más", "está",
+            "él", "mí", "qué", "cómo", "pingüino", "vergüenza", "guion", "teórico-práctico", "ayer", "mañana", "años", "España", "yo", "tú", "usted", "ustedes",
+        ] {
+            // Este diccionario no trae «pingüino» (sí «pingüe»): una laguna suya, no del motor.
+            assert!(w == "pingüino" || is_correct_with(&d, w), "debería ser correcta: {w}");
+        }
+        // Chilenismos: se informa cuáles trae (no se exige ninguno: es jerga y el diccionario decide).
+        let chilenismos: Vec<_> = ["pololo", "carrete", "fome", "bacán", "cachar", "huevón", "weón", "palta", "micro"].into_iter().filter(|w| is_correct_with(&d, w)).collect();
+        eprintln!("chilenismos que trae: {chilenismos:?}");
+        for w in ["cassa", "ninio", "canzion", "hablabamos", "teleono", "docmento", "ortografia", "reunion", "tambien", "acuerdoz", "kasa", "grasias", "haver"] {
+            assert!(!is_correct_with(&d, w), "debería ser un error: {w}");
+        }
+        for (mal, bien) in [("reunion", "reunión"), ("tambien", "también"), ("ortografia", "ortografía"), ("grasias", "gracias"), ("haver", "haber")] {
+            let s = suggest_in_dict(&d, mal);
+            assert!(s.contains(&bien.to_string()), "{mal}: {s:?}");
+        }
+    }
+
+    fn suggest_in_dict(d: &AffixDict, w: &str) -> Vec<String> {
+        suggest::suggest_in(d, w, 8)
+    }
+
+    #[test]
+    fn user_dictionary_applies() {
+        test_dict::install();
+        assert!(!is_correct("zqpalabrapropia"));
+        crate::add_word("Zqpalabrapropia");
+        assert!(is_correct("zqpalabrapropia"));
+    }
+
+    #[test]
+    fn spanish_dispatch_messages_options_and_mixed_spans() {
+        test_dict::install();
+        assert!(crate::has_dictionary(Some("es-CL")));
+        assert!(crate::is_correct_for("casa", Some("spa")));
+        let text = "Casa cassa";
+        let issues = crate::check_text(text, &[(0..text.len(), crate::ProofLang::Es)]);
+        assert_eq!(issues.len(), 1, "{issues:?}");
+        assert_eq!(&text[issues[0].start..issues[0].end], "cassa");
+        assert_eq!(issues[0].message, "Posible error ortográfico");
+        assert_eq!(issues[0].lang, crate::ProofLang::Es);
+        assert!(crate::suggest_in("cassa", 8, crate::ProofLang::Es).contains(&"casa".into()));
+        let text = "Casa this is is wrong";
+        let issues = crate::check_text(text, &[(0..4, crate::ProofLang::Es), (5..text.len(), crate::ProofLang::En)]);
+        assert!(issues.iter().any(|i| i.lang == crate::ProofLang::En && i.message.starts_with("Repeated word")));
+        assert!(issues.iter().all(|i| i.start >= 5));
+        let opts = crate::Options { ignore_uppercase: false, ..Default::default() };
+        assert!(!crate::is_correct_in_with("ZQTERPROHIBIDA", crate::ProofLang::Es, &opts));
+    }
+}
diff --git a/crates/proof/src/es/suggest.rs b/crates/proof/src/es/suggest.rs
new file mode 100644
index 0000000..e50e1ae
--- /dev/null
+++ b/crates/proof/src/es/suggest.rs
@@ -0,0 +1,46 @@
+//! Spanish suggestions. The ranking is the dictionary-driven one Czech uses
+//! ([`crate::cs::suggest::suggest_in`]: case, MAP, REP, missing spaces, KEY, TRY edits and a stem
+//! scan); every table comes from the Spanish dictionary, so nothing Spanish is hard-coded here.
+
+use crate::affix::AffixDict;
+
+/// Spelling suggestions for a Spanish word, best first, at most `max`, in the word's case.
+pub fn suggest(word: &str, max: usize) -> Vec<String> {
+    suggest_in(&super::dictionary(), word, max)
+}
+
+/// [`suggest`] against a given dictionary.
+pub fn suggest_in(d: &AffixDict, word: &str, max: usize) -> Vec<String> {
+    crate::cs::suggest::suggest_in(d, word, max)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn spanish_suggestions_use_runtime_tables_and_case() {
+        crate::es::test_dict::install();
+        for (word, want) in [("cassa", "casa"), ("Cassa", "Casa"), ("chile", "Chile"), ("ninio", "niño"), ("cancion", "canción"), ("lacasa", "la casa")] {
+            assert!(suggest(word, 8).contains(&want.into()), "{word}: {:?}", suggest(word, 8));
+        }
+    }
+
+    #[test]
+    fn suggestions_stay_bounded_and_skip_forbidden_words() {
+        crate::es::test_dict::install();
+        for w in ["", "dos palabras", &"a".repeat(41)] {
+            assert!(suggest(w, 4).is_empty());
+        }
+        assert!(suggest("cassa", 0).is_empty());
+        assert!(suggest_in(&AffixDict::default(), "cassa", 4).is_empty());
+        assert!(suggest("casa", 4).len() <= 4);
+        assert!(!suggest("casa", 4).contains(&"casa".into()));
+        assert!(!suggest("zqterprohibid", 8).contains(&"zqterprohibida".into()));
+    }
+
+    #[test]
+    fn nosuggest_stems_and_forms_are_never_offered() {
+        crate::affix::tests::assert_nosuggest_is_honoured(suggest_in);
+    }
+}
