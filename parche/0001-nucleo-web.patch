diff --git a/crates/web-core/src/lib.rs b/crates/web-core/src/lib.rs
new file mode 100644
index 0000000..0eb4836
--- /dev/null
+++ b/crates/web-core/src/lib.rs
@@ -0,0 +1,245 @@
+//! The editor behind an HTML front end. The page owns the interface (ribbon, dialogs, status bar)
+//! and the input events; this crate owns the document: it runs engine commands, lays the document
+//! out and rasterises pages for `<canvas>`, and answers where the caret and selection are.
+//!
+//! Every action is an engine command (`format.bold`, `caret.left`, `text.insert`…), so the front
+//! end drives the editor with [`Editor::run`] and reads [`Editor::state`] back.
+//!
+//! Data files (the Source Sans face, hyphenation) are fetched by the page and handed over with
+//! [`provide_file`]; faces text needs later are listed by [`wanted_files`] and added with
+//! [`add_lazy_font`].
+#![cfg(target_arch = "wasm32")]
+#![deny(clippy::unwrap_used, clippy::expect_used, clippy::panic)]
+
+use std::sync::Arc;
+
+use serde_json::{Value, json};
+use wasm_bindgen::prelude::*;
+use wordcraft_engine::Session;
+use wordcraft_engine::doc::{Align, PartKind, StoryRef};
+use wordcraft_engine::render::{RenderOptions, render_page};
+use wordcraft_geom::Region;
+
+fn err(e: impl std::fmt::Display) -> JsError {
+    JsError::new(&e.to_string())
+}
+
+/// Files the page must fetch (under its `assets/` folder) before creating an [`Editor`].
+#[wasm_bindgen]
+pub fn core_files() -> Vec<String> {
+    // Only the fallback face: hyphenation and the English dictionary come when text first needs them.
+    vec!["fonts/SourceSans3-Regular.ttf".to_string()]
+}
+
+/// Proof text that has no language of its own in the language of `tag` (`es-CL`): the page sets it once, before creating
+/// an editor. Without it, such text is English, as on desktop.
+#[wasm_bindgen]
+pub fn set_default_language(tag: &str) {
+    wordcraft_engine::proof::lang::set_default_language(wordcraft_engine::proof::ProofLang::from_tag(Some(tag)));
+}
+
+/// Hand over a fetched data file under its asset-relative name.
+#[wasm_bindgen]
+pub fn provide_file(name: &str, bytes: Vec<u8>) {
+    wordcraft_extdata::provide(name, bytes);
+}
+
+/// Files the editor asked for since the last call (faces a document started using).
+#[wasm_bindgen]
+pub fn wanted_files() -> Vec<String> {
+    wordcraft_extdata::take_requests()
+}
+
+/// Add a data file the page fetched on request (hyphenation, dictionary): text is checked and
+/// laid out again with it (see [`Editor::rev`]).
+#[wasm_bindgen]
+pub fn add_data_file(name: &str, bytes: Vec<u8>) {
+    wordcraft_extdata::provide(name, bytes);
+    wordcraft_engine::proof::data_arrived();
+}
+
+/// Add a face the page fetched on request; open documents lay out again (see [`Editor::rev`]).
+#[wasm_bindgen]
+pub fn add_lazy_font(bytes: Vec<u8>) -> usize {
+    wordcraft_fonts::FontDb::global().add_lazy_bundled(bytes)
+}
+
+#[wasm_bindgen]
+pub struct Editor {
+    session: Session,
+    /// Changes whenever something the page shows could have changed.
+    rev: u64,
+    fonts: u64,
+    proofing: u64,
+}
+
+#[wasm_bindgen]
+impl Editor {
+    /// A blank document on the paper of `locale` (`es-CL`: Letter), written in that language: its text is proofed in it.
+    #[wasm_bindgen(constructor)]
+    pub fn new(locale: &str) -> Editor {
+        let region = Region::from_tag(locale);
+        let mut doc = wordcraft_engine::blank_document(&region);
+        // The document's default language (a new document has en-US): what its text is proofed in.
+        doc.styles.default_chr.lang = wordcraft_engine::proof::lang::normalize_tag(locale).or_else(|| Some(locale.to_string()));
+        let mut session = Session::new(doc);
+        session.system_region = region;
+        Editor::from(session)
+    }
+
+    /// The sample document.
+    pub fn sample() -> Editor {
+        Editor::from(Session::new(wordcraft_engine::sample::sample_document()))
+    }
+
+    /// Replace the document with a file's contents (`.docx`, `.odt`, `.rtf`, `.txt`…, by name).
+    pub fn open(&mut self, name: &str, bytes: &[u8]) -> Result<(), JsError> {
+        let doc = wordcraft_engine::io::open_bytes(name, bytes).map_err(err)?;
+        self.session.set_document(doc);
+        self.rev += 1;
+        Ok(())
+    }
+
+    /// The document as a file in the format of `name`'s extension.
+    pub fn save(&mut self, name: &str) -> Result<Vec<u8>, JsError> {
+        // Como Word en cada guardado: fecha, autor y revisión del archivo.
+        self.session.stamp_save();
+        wordcraft_engine::io::save_bytes(name, &self.session.doc).map_err(err)
+    }
+
+    /// El documento quedó guardado (en la nube o descargado): ya no tiene cambios pendientes.
+    pub fn mark_saved(&mut self) {
+        self.session.dirty = false;
+        self.rev += 1;
+    }
+
+    /// Run an engine command (`params` is JSON). Returns the command's JSON result.
+    pub fn run(&mut self, id: &str, params: &str) -> Result<String, JsError> {
+        let v: Value = if params.is_empty() { json!({}) } else { serde_json::from_str(params).map_err(err)? };
+        let out = self.session.run(id, &v).map_err(err)?;
+        self.rev += 1;
+        Ok(out.to_string())
+    }
+
+    /// Bumps on every change to the document, selection or fonts: redraw when it moves.
+    pub fn rev(&mut self) -> f64 {
+        let g = wordcraft_fonts::FontDb::global().generation();
+        let p = wordcraft_engine::proof::dictionary_generation();
+        if g != self.fonts || p != self.proofing {
+            self.fonts = g;
+            self.proofing = p;
+            self.session.relayout();
+            self.rev += 1;
+        }
+        self.rev as f64
+    }
+
+    pub fn page_count(&mut self) -> usize {
+        self.session.layout().pages.len()
+    }
+
+    /// `[width, height]` of a page in points.
+    pub fn page_size(&mut self, page: usize) -> Vec<f32> {
+        self.session.layout().pages.get(page).map(|p| vec![p.w, p.h]).unwrap_or_default()
+    }
+
+    /// The page as straight RGBA, `ceil(width * scale)` pixels wide (`ImageData` order).
+    pub fn render_page(&mut self, page: usize, scale: f32) -> Vec<u8> {
+        let layout = self.session.layout();
+        let Some(p) = layout.pages.get(page) else { return Vec::new() };
+        render_page(&self.session.doc, p, scale, &RenderOptions::default()).to_straight()
+    }
+
+    /// Put the caret at a point of a page (points), or extend the selection to it.
+    pub fn click(&mut self, page: usize, x: f32, y: f32, extend: bool) -> bool {
+        let layout = self.session.layout();
+        let story = self.session.sel.focus.story;
+        let Some(pos) = layout.hit(page, x, y, story) else { return false };
+        self.session.page_hint = page;
+        if extend {
+            self.session.sel.focus = pos;
+        } else {
+            self.session.sel = wordcraft_engine::Selection::caret(pos);
+        }
+        self.session.close_typing();
+        self.rev += 1;
+        true
+    }
+
+    /// `{page, x, top, height}` of the caret, or `null`.
+    pub fn caret(&mut self) -> String {
+        let layout = self.session.layout();
+        match layout.caret_on(&self.session.sel.focus, self.session.page_hint) {
+            Some(c) => json!({"page": c.page, "x": c.x, "top": c.top, "height": c.height}).to_string(),
+            None => "null".into(),
+        }
+    }
+
+    /// `[[page, x, y, w, h], …]` covering the selection (empty when collapsed).
+    pub fn selection_rects(&mut self) -> String {
+        if self.session.sel.is_collapsed() {
+            return "[]".into();
+        }
+        let layout = self.session.layout();
+        let (a, b) = self.session.sel.ordered();
+        let rects: Vec<Value> = layout.selection_rects(&self.session.doc, &a, &b, self.session.page_hint).iter().map(|(p, r)| json!([p, r.x, r.y, r.w, r.h])).collect();
+        Value::Array(rects).to_string()
+    }
+
+    /// What the interface shows: the formatting at the caret (as the styles resolve it, so a heading shows its own font and
+    /// size, not only direct formatting), the paragraph's alignment, where the caret is, undo state, counts.
+    pub fn state(&mut self) -> String {
+        let pages = self.session.layout().pages.len();
+        // `format.state` only reads: it is what the desktop ribbon shows. Mixed values come back null.
+        let f = self.session.run("format.state", &json!({})).unwrap_or(Value::Null);
+        // Del primer párrafo de la selección (como Word): una selección que termina al inicio del párrafo siguiente (un triple
+        // clic) no debe mostrar la alineación de ese.
+        let start = self.session.sel.ordered().0;
+        let align = self
+            .session
+            .doc
+            .para_at(&start)
+            .map(|p| match self.session.doc.styles.resolve_para(&p.props).align {
+                Align::Left => "left",
+                Align::Center => "center",
+                Align::Right => "right",
+                Align::Justify | Align::Distribute => "justify",
+            })
+            .unwrap_or("left");
+        let story = match self.session.sel.focus.story {
+            StoryRef::Body => "body",
+            StoryRef::Part(id) => match self.session.doc.parts.get(&id).map(|p| &p.kind) {
+                Some(PartKind::Header) => "header",
+                Some(PartKind::Footer) => "footer",
+                _ => "other",
+            },
+        };
+        json!({
+            "bold": f["bold"],
+            "italic": f["italic"],
+            "underline": f["underline"],
+            "strike": f["strike"],
+            "font": f["font"],
+            "size": f["size"],
+            "color": f["color"],
+            "align": align,
+            "story": story,
+            "canUndo": self.session.can_undo(),
+            "canRedo": self.session.can_redo(),
+            "dirty": self.session.dirty,
+            "pages": pages,
+            "words": self.session.word_count(),
+            "selection": self.session.selected_text().chars().count(),
+        })
+        .to_string()
+    }
+}
+
+impl From<Session> for Editor {
+    fn from(mut session: Session) -> Editor {
+        let fonts = wordcraft_fonts::FontDb::global().generation();
+        let proofing = wordcraft_engine::proof::dictionary_generation();
+        let _ = Arc::strong_count(&session.layout());
+        Editor { session, rev: 1, fonts, proofing }
+    }
+}
