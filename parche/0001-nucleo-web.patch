index 0000000..c42c6a2
--- /dev/null
+++ b/apps/wordcraft-web/src/assets.rs
@@ -0,0 +1,92 @@
+//! Data kept out of the wasm and fetched by the page (`wordcraft_extdata`): the bundled faces,
+//! hyphenation patterns and the interface catalog of the language in use. Files sit next to the
+//! page under `assets/` (see `index.html`); the browser caches them separately from the wasm.
+
+use std::cell::RefCell;
+use std::collections::HashSet;
+
+use wasm_bindgen::JsCast as _;
+use wasm_bindgen_futures::JsFuture;
+
+const BASE: &str = "assets/";
+// The web build is Spanish-only: one interface catalog, and hyphenation for English (the default
+// document language); Polish, Portuguese and Italian patterns stay out.
+const HYPHENATION: &[&str] = &["en-us.dic", "en-us.pat"];
+const INTERFACE: &str = "es";
+
+thread_local! {
+    /// Catalogs requested so far, so each is fetched once.
+    static REQUESTED: RefCell<HashSet<String>> = RefCell::default();
+}
+
+/// Everything the app needs before its first frame: faces, hyphenation, and the catalog of the
+/// language the interface starts in (`code`).
+pub async fn preload(code: &str) -> Result<(), String> {
+    // Faces text needs from the start; the rest arrive when asked for (`serve_requests`).
+    let mut names: Vec<String> =
+        wordcraft_fonts::BUNDLED_FILES.iter().filter(|f| !wordcraft_fonts::LAZY_FILES.contains(f)).map(|f| format!("fonts/{f}")).collect();
+    names.extend(HYPHENATION.iter().map(|f| format!("hyphenation/{f}")));
+    if let Some(n) = catalog_name(code) {
+        names.push(n);
+    }
+    fetch_into_registry(names).await
+}
+
+/// Fetch the catalog for `code` in the background when it isn't loaded; `done` runs afterwards.
+pub fn ensure_catalog(code: &str, done: impl FnOnce() + 'static) {
+    let Some(name) = catalog_name(code) else { return };
+    if wordcraft_extdata::bytes(&name).is_some() || !REQUESTED.with(|r| r.borrow_mut().insert(name.clone())) {
+        return;
+    }
+    wasm_bindgen_futures::spawn_local(async move {
+        match fetch_into_registry(vec![name.clone()]).await {
+            Ok(()) => done(),
+            Err(e) => log::warn!("interface language not loaded: {e}"),
+        }
+    });
+}
+
+/// `i18n/es.tsv` for Spanish; English is built in and no other language ships.
+pub fn catalog_name(code: &str) -> Option<String> {
+    (code == INTERFACE).then(|| format!("i18n/{code}.tsv"))
+}
+
+/// Fetch the files code asked for since the last frame (bundled faces text started using) and
+/// add them to the font database, which makes the app lay out again.
+pub fn serve_requests(ctx: &egui::Context) {
+    for name in wordcraft_extdata::take_requests() {
+        let ctx = ctx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            if let Err(e) = fetch_into_registry(vec![name.clone()]).await {
+                log::warn!("font not loaded: {e}");
+                return;
+            }
+            if let Some(bytes) = wordcraft_extdata::bytes(&name) {
+                wordcraft_fonts::FontDb::global().add_lazy_bundled(bytes.to_vec());
+                ctx.request_repaint();
+            }
+        });
+    }
+}
+
+async fn fetch_into_registry(names: Vec<String>) -> Result<(), String> {
+    let window = web_sys::window().ok_or("no window")?;
+    let requests = js_sys::Array::new();
+    for n in &names {
+        requests.push(&window.fetch_with_str(&format!("{BASE}{n}")));
+    }
+    let responses = JsFuture::from(js_sys::Promise::all(&requests)).await.map_err(|e| format!("{e:?}"))?;
+    let buffers = js_sys::Array::new();
+    for r in js_sys::Array::from(&responses).iter() {
+        let r: web_sys::Response = r.dyn_into().map_err(|_| "not a response".to_string())?;
+        if !r.ok() {
+            return Err(format!("{} {}", r.status(), r.url()));
+        }
+        buffers.push(&r.array_buffer().map_err(|e| format!("{e:?}"))?.into());
+    }
+    let data = JsFuture::from(js_sys::Promise::all(&buffers)).await.map_err(|e| format!("{e:?}"))?;
+    for (n, buf) in names.into_iter().zip(js_sys::Array::from(&data).iter()) {
+        wordcraft_extdata::provide(&n, js_sys::Uint8Array::new(&buf).to_vec());
+    }
+    Ok(())
+}
